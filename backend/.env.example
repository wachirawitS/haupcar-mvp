# Copy to .env for local dev (`npm run start:dev`). Never commit .env.
# Docker Compose sets these itself; see ../docker-compose.yml.

PORT=4000
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=haupcar
DB_PASSWORD=haupcar
DB_NAME=haupcar

# Internal endpoint the API uses / browser-reachable URL put in image responses
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=car-images
CAR_IMAGES_MAX=10
IMAGE_MAX_BYTES=5242880

AUTH_USERNAME=somchai
AUTH_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
